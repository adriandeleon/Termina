#!/bin/sh
# prerm script for APPLICATION_PACKAGE
#
# jpackage's own template (JDK 25, template.prerm) with the undoing of postinst's system integration
# added. The tokens are jpackage's and are substituted as in the stock script.
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <prerm> `remove'
#        * <old-prerm> `upgrade' <new-version>
#        * <new-prerm> `failed-upgrade' <old-version>
#        * <conflictor's-prerm> `remove' `in-favour' <package> <new-version>
#        * <deconfigured's-prerm> `deconfigure' `in-favour'
#          <package-being-installed> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package


package_type=deb
COMMON_SCRIPTS
DESKTOP_SCRIPTS
LAUNCHER_AS_SERVICE_SCRIPTS

termina_launcher=/opt/termina/bin/Termina

# Only on the way out, not on an upgrade: the new postinst puts the same things back, and dropping
# the alternative in between would lose a user's choice of Termina as the default terminal.
termina_disintegrate ()
{
    update-alternatives --remove x-terminal-emulator "$termina_launcher" || true
    if [ -L /usr/bin/termina ] && [ "$(readlink /usr/bin/termina)" = "$termina_launcher" ]; then
        rm -f /usr/bin/termina
    fi
}

case "$1" in
    remove|upgrade|deconfigure)
DESKTOP_COMMANDS_UNINSTALL
LAUNCHER_AS_SERVICE_COMMANDS_UNINSTALL
        if [ "$1" != upgrade ]; then
            termina_disintegrate
        fi
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
