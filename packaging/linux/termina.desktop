[Desktop Entry]
Type=Application
Name=Termina
GenericName=Terminal
Comment=A keyboard-driven terminal emulator
Exec=termina
Icon=termina
Terminal=false
# TerminalEmulator is what makes desktops offer Termina where a terminal is wanted — "Open in
# Terminal" in a file manager, and the terminal picker in GNOME and KDE settings.
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command line;console;
# The real WM_CLASS, which JavaFX derives from the module's main class rather than from the
# application name. Without it the running window cannot be matched to this entry, so the dock shows
# a second, generic icon beside the launcher instead of highlighting it. Verify on a real desktop
# with `xprop WM_CLASS` and click the window — assuming the value is how this goes wrong quietly.
StartupWMClass=com.termina.App
