<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.termina</groupId>
    <artifactId>termina</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Termina</name>
    <description>A cross-platform terminal emulator built on JavaFX</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Indirected through a property: the format is ignored when maven.build.timestamp is
             filtered into a resource directly. -->
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm 'UTC'</maven.build.timestamp.format>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>

        <javafx.version>26.0.2</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>

        <!-- Prism pipeline order (-Dprism.order). Set per-OS in the os-* profiles:
             mac=mtl,es2,sw (Metal — fixes M-series es2 render-to-texture glitches),
             windows=d3d,es2,sw (keep Direct3D), linux=es2,sw. This default covers
             profile-less builds (e.g. plain `mvn test`, which doesn't render). -->
        <prism.pipeline>es2,sw</prism.pipeline>
        <!-- Overridden per-OS below; jpackage wants .icns on macOS, .ico on Windows, .png on Linux. -->
        <jpackage.icon>${project.basedir}/branding/termina.png</jpackage.icon>
        <skip.mac.version.fix>true</skip.mac.version.fix>

        <!-- JediTerm: the VT/xterm emulation core (screen buffer + escape-sequence parser),
             UI-agnostic. NOT on Maven Central — see <repositories> below. -->
        <jediterm.version>3.74</jediterm.version>
        <!-- pty4j: the PTY. One jar carries natives for every platform we ship:
             macOS universal dylib, 7 Linux arches, Windows ConPTY + winpty fallback. -->
        <pty4j.version>0.13.10</pty4j.version>

        <!-- Both jediterm-core and pty4j are Kotlin, and they disagree on the stdlib
             version (2.4.0 vs 2.1.21). Pinned in <dependencyManagement> so the choice is
             ours rather than Maven's nearest-wins. Likewise JNA: pty4j asks for 5.14.0. -->
        <kotlin.version>2.4.0</kotlin.version>
        <jna.version>5.17.0</jna.version>
        <slf4j.version>2.0.17</slf4j.version>

        <!-- The release-check response is a large JSON document with user-authored text in it, so
             it gets a real parser. Hand-rolling one to save a dependency would mean hand-rolling
             string-escape handling, which is the entire hard part. jackson-core only — no
             databind, and it is already a proper JPMS module, so jlink links it without moditect. -->
        <jackson.version>2.19.0</jackson.version>

        <junit.version>5.11.4</junit.version>

        <!-- dist profile only -->
        <moditect.version>1.2.2.Final</moditect.version>
        <jpackage.plugin.version>1.6.6</jpackage.plugin.version>
    </properties>

    <repositories>
        <!-- JediTerm is published only to JetBrains' own repository. -->
        <repository>
            <id>intellij-dependencies</id>
            <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.jediterm</groupId>
            <artifactId>jediterm-core</artifactId>
            <version>${jediterm.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>${pty4j.version}</version>
        </dependency>

        <!-- jediterm-core and pty4j both declare slf4j-api at runtime scope, which keeps it
             off the compile module path. We need it resolved as a real module (module-info
             wires it explicitly — see the note there), so declare it at compile scope. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Without a binding slf4j prints a "no providers" warning and drops every log line.
             simple writes to stderr; swap for a real backend when there's somewhere to write to. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- build-info.properties is filtered so the version comes from this pom and nowhere
                 else; every other file reads it through AppInfo. A release then means editing one
                 number. Everything else is copied verbatim — filtering the CSS would mangle any
                 ${...} it contains. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>com/termina/build-info.properties</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>com/termina/build-info.properties</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath (unnamed module) so they can reach
                         package-private members and setAccessible freely. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.termina/com.termina.App</mainClass>
                    <options>
                        <!-- JNA loads the pty4j native library through System.load. Without this the
                             JDK warns on every launch, and it says the call will be blocked outright
                             in a future release. ALL-UNNAMED is needed because this plugin puts the
                             non-required jars on the classpath rather than the module path. -->
                        <option>--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
                        <option>-Dprism.order=${prism.pipeline}</option>
                    </options>
                    <launcher>termina</launcher>
                    <jlinkImageName>termina</jlinkImageName>
                    <jlinkZipName>termina</jlinkZipName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <prism.pipeline>mtl,es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/termina.icns</jpackage.icon>
                <skip.mac.version.fix>false</skip.mac.version.fix>
            </properties>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <prism.pipeline>d3d,es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/termina.ico</jpackage.icon>
            </properties>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <properties>
                <prism.pipeline>es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/termina.png</jpackage.icon>
            </properties>
        </profile>

        <!--
            Native app image:  mvn clean -Pdist package  =>  target/dist/Termina{.app}

            `clean` matters. jlink's input is built from target/classes, and an incremental compile
            can leave that directory inconsistent with the sources in ways javac will not correct.

            Four of our dependencies are automatic modules (no module-info), and jlink refuses to
            link those. moditect injects real descriptors; the antrun step then overlays the patched
            jars on top of the plain ones so the module path holds exactly one copy of each.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.moditect</groupId>
                        <artifactId>moditect-maven-plugin</artifactId>
                        <version>${moditect.version}</version>
                        <executions>
                            <execution>
                                <id>patch-automatic-modules</id>
                                <phase>package</phase>
                                <goals><goal>add-module-info</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                    <overwriteExistingFiles>true</overwriteExistingFiles>
                                    <jdepsExtraArgs>
                                        <arg>--multi-release=25</arg>
                                        <!-- These jars reference optional dependencies we do not
                                             bundle (JNA's AWT bridge, pty4j's Windows-only paths on
                                             a mac build). Let jdeps skip what it cannot resolve
                                             rather than fail the whole descriptor. -->
                                        <arg>--ignore-missing-deps</arg>
                                    </jdepsExtraArgs>
                                    <modules>
                                        <module>
                                            <artifact>
                                                <groupId>net.java.dev.jna</groupId>
                                                <artifactId>jna</artifactId>
                                                <version>${jna.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.sun.jna</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>net.java.dev.jna</groupId>
                                                <artifactId>jna-platform</artifactId>
                                                <version>${jna.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>com.sun.jna.platform</name>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>org.jetbrains.jediterm</groupId>
                                                <artifactId>jediterm-core</artifactId>
                                                <version>${jediterm.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>jediterm.core</name>
                                                <!-- jdeps sees the Kotlin and slf4j calls, but the
                                                     module names it derives are only as good as
                                                     what is on its path; state them so a dropped
                                                     requires cannot make the linked image fail at
                                                     the first emulator call instead of at build. -->
                                                <requires>
                                                    kotlin.stdlib;
                                                    org.slf4j;
                                                    java.desktop;
                                                    *;
                                                </requires>
                                            </moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>org.jetbrains.pty4j</groupId>
                                                <artifactId>pty4j</artifactId>
                                                <version>${pty4j.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>pty4j</name>
                                                <requires>
                                                    kotlin.stdlib;
                                                    org.slf4j;
                                                    com.sun.jna;
                                                    com.sun.jna.platform;
                                                    *;
                                                </requires>
                                            </moduleInfo>
                                        </module>
                                    </modules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>collect-modules</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/mods</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <!--
                                  jpackage will not accept a version it cannot parse, and macOS
                                  additionally refuses one whose first number is zero — so a 0.x pom
                                  fails there and only there. Both are handled here rather than by
                                  hardcoding a number, which is what this replaced: the bundle
                                  claimed 1.0.0 while the application reported 0.1.0-SNAPSHOT, so
                                  Finder, the About box and the update check all disagreed.
                                -->
                                <id>derive-versions</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.publicVersion">
                                            <string value="${project.version}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-SNAPSHOT$" replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <loadresource property="jpackage.macVersion">
                                            <string value="${jpackage.publicVersion}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="^0\." replace="1."/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <condition property="jpackage.appVersion"
                                                   value="${jpackage.macVersion}"
                                                   else="${jpackage.publicVersion}">
                                            <os family="mac"/>
                                        </condition>
                                        <echo message="version ${project.version}: public ${jpackage.publicVersion}, bundle ${jpackage.appVersion}"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>assemble-module-path</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <!-- Patched jars win over the plain automatic ones. -->
                                        <copy todir="${project.build.directory}/mods" overwrite="true">
                                            <fileset dir="${project.build.directory}/modules"/>
                                        </copy>
                                        <copy todir="${project.build.directory}/mods"
                                              file="${project.build.directory}/${project.build.finalName}.jar"/>
                                        <!-- JavaFX publishes a stub jar plus a platform-classifier jar
                                             with the real classes. Both declare the same module, so
                                             leaving both on the path is a duplicate-module error. -->
                                        <delete>
                                            <fileset dir="${project.build.directory}/mods"
                                                     includes="javafx-*-${javafx.version}.jar"/>
                                        </delete>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>${jpackage.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>app-image</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                    <name>Termina</name>
                                    <appVersion>${jpackage.appVersion}</appVersion>
                                    <vendor>Termina</vendor>
                                    <icon>${jpackage.icon}</icon>
                                    <destination>${project.build.directory}/dist</destination>
                                    <module>com.termina/com.termina.App</module>
                                    <modulePaths>
                                        <modulePath>${project.build.directory}/mods</modulePath>
                                    </modulePaths>
                                    <!--
                                        The slf4j binding is reached only through ServiceLoader, so
                                        nothing `requires` it and jlink leaves it out of the image
                                        without a word. The result builds and launches, and every
                                        log line from pty4j and JediTerm silently disappears — in
                                        the one build where a native library failing to load is
                                        hardest to diagnose. Named explicitly rather than binding
                                        all services, which would drag in every provider on the
                                        module path.
                                    -->
                                    <addModules>
                                        <addModule>org.slf4j.simple</addModule>
                                    </addModules>
                                    <javaOptions>
                                        <javaOption>--enable-native-access=javafx.graphics,com.sun.jna</javaOption>
                                        <javaOption>-Dprism.order=${prism.pipeline}</javaOption>
                                    </javaOptions>
                                    <jLinkOptions>
                                        <jLinkOption>--strip-debug</jLinkOption>
                                        <jLinkOption>--no-man-pages</jLinkOption>
                                        <jLinkOption>--no-header-files</jLinkOption>
                                        <jLinkOption>--compress=zip-6</jLinkOption>
                                    </jLinkOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <!--
                          Declared after jpackage on purpose: both are bound to `package`, and within
                          a phase Maven runs plugins in the order the POM lists them. Bound earlier
                          it ran before the bundle it edits existed.
                        -->
                        <id>fix-mac-bundle-version</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${project.basedir}/scripts/fix-mac-bundle-version.sh</executable>
                            <arguments>
                                <argument>${project.build.directory}/dist/Termina.app</argument>
                                <argument>${jpackage.publicVersion}</argument>
                            </arguments>
                            <!-- Nothing to fix where there is no bundle; the script exits 0 anyway. -->
                            <skip>${skip.mac.version.fix}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
            </build>
        </profile>
    </profiles>
</project>
