# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,html}]
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{css,properties}]
indent_size = 4

[*.sh]
indent_size = 4

# Generated by Maven; left exactly as the wrapper plugin writes them.
[{mvnw,mvnw.cmd}]
trim_trailing_whitespace = false
insert_final_newline = false
